{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "splash.jsx",
              "splash/**",
              "src/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--bg",
      "--border",
      "--border-soft",
      "--error",
      "--error-bg",
      "--nav-h",
      "--primary",
      "--primary-dark",
      "--primary-soft",
      "--r-card",
      "--r-input",
      "--r-pill",
      "--shadow",
      "--shadow-lg",
      "--success",
      "--success-bg",
      "--surface",
      "--text-1",
      "--text-2",
      "--text-3",
      "--warning",
      "--warning-bg"
    ],
    "tokenKinds": {
      "--primary": "color",
      "--primary-soft": "color",
      "--primary-dark": "color",
      "--accent": "color",
      "--bg": "color",
      "--surface": "color",
      "--border-soft": "color",
      "--border": "color",
      "--text-1": "font",
      "--text-2": "font",
      "--text-3": "font",
      "--success": "color",
      "--success-bg": "color",
      "--warning": "color",
      "--warning-bg": "color",
      "--error": "color",
      "--error-bg": "color",
      "--r-card": "spacing",
      "--r-input": "spacing",
      "--r-pill": "spacing",
      "--shadow": "shadow",
      "--shadow-lg": "shadow",
      "--nav-h": "spacing"
    },
    "fontFamilies": []
  }
}